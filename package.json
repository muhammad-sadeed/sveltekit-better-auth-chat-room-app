{
	"name": "sv-better-auth",
	"private": true,
	"version": "0.0.1",
	"author": "Muhammad Sadeed",
	"type": "module",
	"main": "electron/main.mjs",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"electron:dev": "concurrently -k \"vite dev\" \"wait-on tcp:5173 && ELECTRON_DEV=1 electron .\"",
		"electron:start": "electron .",
		"electron:dist": "electron-builder --mac",
		"electron:dist:win": "electron-builder --win",
		"electron:dist:all": "electron-builder --mac --win",
		"icon": "bun run electron/build/generate-icon.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"build": {
		"appId": "com.muhammadsadeed.p2pchat",
		"productName": "P2P Chat",
		"directories": {
			"output": "dist-electron",
			"buildResources": "electron/build"
		},
		"files": [
			"electron/main.mjs",
			"electron/preload.cjs",
			"package.json",
			"!node_modules/**/*"
		],
		"mac": {
			"target": [
				"dmg"
			],
			"category": "public.app-category.social-networking",
			"icon": "electron/build/icon.png"
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				{
					"target": "portable",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "electron/build/icon.png"
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.59.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"bits-ui": "^2.18.0",
		"cn": "^0.3.0",
		"concurrently": "^10.0.6",
		"electron": "^44.9.0",
		"electron-builder": "^26.15.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"wait-on": "^9.5.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"better-auth": "^1.7.10",
		"mode-watcher": "^1.1.0",
		"mongodb": "^7.7.0",
		"trystero": "^0.26.0",
		"zod": "^4.6.7"
	}
}
